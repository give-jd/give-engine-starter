"""Le Mie Spese — generato da Gi.Ve Engine ({{ generated_at }})."""

from __future__ import annotations

import io
from datetime import date

import pandas as pd
import plotly.express as px
import streamlit as st

from database import (
    CATEGORIE,
    DB_PATH,
    delete_spesa,
    ensure_schema,
    fetch_all,
    insert_spesa,
)


st.set_page_config(
    page_title="Le Mie Spese",
    page_icon="💶",
    layout="wide",
    initial_sidebar_state="expanded",
)


ensure_schema()


# ---- Sidebar: form di inserimento ------------------------------------------

st.sidebar.title("➕ Aggiungi una spesa")
st.sidebar.caption("Compila i campi e premi conferma.")

with st.sidebar.form("nuova_spesa", clear_on_submit=True):
    sp_data = st.date_input("Data", value=date.today(), max_value=date.today())
    sp_categoria = st.selectbox("Categoria", CATEGORIE)
    sp_importo = st.number_input("Importo (€)", min_value=0.0, step=0.50, format="%.2f")
    sp_descrizione = st.text_input("Descrizione", placeholder="es. Spesa Esselunga")
    submitted = st.form_submit_button("✅ Aggiungi spesa", use_container_width=True)
    if submitted:
        if sp_importo <= 0:
            st.error("L'importo deve essere maggiore di zero.")
        else:
            insert_spesa(sp_data.isoformat(), sp_categoria, float(sp_importo), sp_descrizione.strip())
            st.success(f"Spesa di €{sp_importo:.2f} aggiunta.")
            st.rerun()


# ---- Main: titolo + KPI ----------------------------------------------------

st.title("Le Mie Spese")
st.caption(f"Database locale: `{DB_PATH.name}` · I tuoi dati restano sul tuo PC.")

df = fetch_all()
oggi = date.today()
mese_corrente = oggi.strftime("%Y-%m")
mask_mese = pd.Series([], dtype=bool)

if not df.empty:
    df["data"] = pd.to_datetime(df["data"])
    mask_mese = df["data"].dt.strftime("%Y-%m") == mese_corrente
    totale_mese = float(df.loc[mask_mese, "importo"].sum())
    totale_anno = float(df.loc[df["data"].dt.year == oggi.year, "importo"].sum())
    n_spese = int(mask_mese.sum())
else:
    totale_mese = totale_anno = 0.0
    n_spese = 0

k1, k2, k3, k4 = st.columns(4)
k1.metric("Totale del mese", f"€ {totale_mese:,.2f}".replace(",", "."))
k2.metric("Totale dell'anno", f"€ {totale_anno:,.2f}".replace(",", "."))
k3.metric("Spese nel mese", str(n_spese))
k4.metric("Categorie attive", str(df["categoria"].nunique()) if not df.empty else "0")


# ---- Esportazione xlsx -----------------------------------------------------

col_export_a, col_export_b = st.columns([3, 1])
with col_export_b:
    if not df.empty:
        buf = io.BytesIO()
        df_export = df.copy()
        df_export["data"] = df_export["data"].dt.strftime("%Y-%m-%d")
        with pd.ExcelWriter(buf, engine="openpyxl") as writer:
            df_export.to_excel(writer, sheet_name="Spese", index=False)
        st.download_button(
            "⬇️ Esporta in Excel",
            data=buf.getvalue(),
            file_name=f"spese_{oggi.isoformat()}.xlsx",
            mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            use_container_width=True,
        )


# ---- Tabella ultime + grafico torta ----------------------------------------

st.subheader("Le tue spese")

if df.empty:
    st.info("Non hai ancora registrato nessuna spesa. Usa il modulo a sinistra.")
else:
    col_tab, col_chart = st.columns([3, 2])

    with col_tab:
        st.caption("Ultime 20 spese")
        df_show = (
            df.sort_values("data", ascending=False)
              .head(20)
              .assign(data=lambda d: d["data"].dt.strftime("%d/%m/%Y"),
                      importo=lambda d: d["importo"].map(lambda v: f"€ {v:,.2f}".replace(",", ".")))
              [["data", "categoria", "importo", "descrizione"]]
              .rename(columns={
                  "data": "Data", "categoria": "Categoria",
                  "importo": "Importo", "descrizione": "Descrizione",
              })
        )
        st.dataframe(df_show, use_container_width=True, hide_index=True)

    with col_chart:
        st.caption(f"Distribuzione del mese ({oggi.strftime('%B %Y')})")
        mese_df = df.loc[mask_mese].groupby("categoria", as_index=False)["importo"].sum()
        if mese_df.empty:
            st.info("Nessuna spesa registrata in questo mese.")
        else:
            fig = px.pie(
                mese_df, names="categoria", values="importo",
                hole=0.55, color_discrete_sequence=px.colors.sequential.Plasma,
            )
            fig.update_layout(
                showlegend=True,
                margin=dict(l=0, r=0, t=10, b=0),
                paper_bgcolor="rgba(0,0,0,0)",
                plot_bgcolor="rgba(0,0,0,0)",
                font=dict(color="#e2e8f0"),
            )
            st.plotly_chart(fig, use_container_width=True)


# ---- Footer ----------------------------------------------------------------

st.divider()
with st.expander("Suggerimenti rapidi"):
    st.markdown(
        "- Aggiungi le spese giorno per giorno: bastano pochi secondi.\n"
        "- Esporta in Excel a fine mese per il tuo bilancio familiare.\n"
        "- Per cancellare una spesa errata, usa la sezione sotto."
    )

with st.expander("✂ Cancella una spesa"):
    if df.empty:
        st.caption("Nessuna spesa da cancellare.")
    else:
        opts = {
            f"{row['data'].strftime('%d/%m/%Y')} · {row['categoria']} · €{row['importo']:.2f} · {row['descrizione'][:40]}": int(row["id"])
            for _, row in df.sort_values("data", ascending=False).head(50).iterrows()
        }
        scelta = st.selectbox("Seleziona la spesa", list(opts.keys()))
        if st.button("Cancella", type="secondary"):
            delete_spesa(opts[scelta])
            st.success("Spesa cancellata.")
            st.rerun()
